# Sarvam AI API Key & Flagship Indic LLM (Powers Perception, Speech, Vision, and Cognee Memory Graph)
SARVAM_API_KEY="your_sarvam_api_key_here"
SARVAM_MODEL="sarvam-105b-conversations"

# n8n Automation Cloud Webhook Endpoint
N8N_WEBHOOK_URL="https://your-workspace.app.n8n.cloud/webhook/trigger"

# Cognee Knowledge Graph Engine (Configured with Sarvam Indic LLM)
COGNEE_API_KEY="your_cognee_api_key_here"
